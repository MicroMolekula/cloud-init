#cloud-config

users:
  - name: root
    lock_passwd: false
    ssh_authorized_keys:
       - ssh-rsa  luke@luke-neon
ssh_pwauth: false
disable_root: false

write_files:
  - path: /etc/garage.toml
    permissions: '0644'
    content: |
      metadata_dir="/var/lib/garage/meta"
      data_dir="/var/lib/garage/data"
      db_engine = "sqlite"

      replication_factor = 1

      rpc_bind_addr = "[::]:3901"
      rpc_public_addr = "127.0.0.1:3901"
      rpc_secret = "@RPC_SECRET"

      [s3_api]
      s3_region = "garage"
      api_bind_addr = "[::]:3900"
      root_domain = ".s3.garage.localhost"
      advertise_endpoint = "http://s3.garage.localhost:3900"

      [s3_web]
      bind_addr = "[::]:3902"
      root_domain = ".web.garage.localhost"
      index = "index.html"

      [admin]
      api_bind_addr = "[::]:3903"
      admin_token = "@ADMIN_TOKEN"
      metrics_token = "@METRICS_TOKEN"
  - permissions: "0711"
    defer: true
    source:
      uri: http://192.168.1.42:8080/garage
    path: /usr/bin/garage
  - permissions: "644"
    path: /etc/systemd/system/garage.service
    content: |
      [Unit]
      Description=Garage Data Store
      After=network-online.target
      Wants=network-online.target

      [Service]
      Environment='RUST_LOG=garage=info' 'RUST_BACKTRACE=1'
      ExecStart=/usr/bin/garage server
      StateDirectory=garage
      DynamicUser=true
      ProtectHome=true
      NoNewPrivileges=true
      LimitNOFILE=42000

      [Install]
      WantedBy=multi-user.target

    
runcmd:
  - sed -i "s|@RPC_SECRET|$(openssl rand -hex 32)|g" /etc/garage.toml
  - sed -i "s|@ADMIN_TOKEN|$(openssl rand -base64 32)|g" /etc/garage.toml
  - sed -i "s|@METRICS_TOKEN|$(openssl rand -base64 32)|g" /etc/garage.toml
  - systemctl start garage
  - systemctl enable garage


