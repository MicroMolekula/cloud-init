#cloud-config

users:
  - name: root
    lock_passwd: false
    ssh_authorized_keys:
       - ssh-rsa  luke@luke-neon
ssh_pwauth: false
disable_root: false

write_files:
  - path: /etc/garage.toml
    permissions: '0600'
    content: |
      metadata_dir = "/tmp/meta"
      data_dir = "/tmp/data"
      db_engine = "sqlite"

      replication_factor = 1

      rpc_bind_addr = "[::]:3901"
      rpc_public_addr = "127.0.0.1:3901"
      rpc_secret = "@RPC_SECRET"

      [s3_api]
      s3_region = "garage"
      api_bind_addr = "[::]:3900"
      root_domain = ".s3.garage.localhost"
      advertise_endpoint = "http://s3.garage.localhost:3900"

      [s3_web]
      bind_addr = "[::]:3902"
      root_domain = ".web.garage.localhost"
      index = "index.html"

      [admin]
      api_bind_addr = "[::]:3903"
      admin_token = "@ADMIN_TOKEN"
      metrics_token = "@METRICS_TOKEN"
  - permissions: "0711"
    defer: true
    source:
      uri: https://garagehq.deuxfleurs.fr/_releases/v2.4.1/aarch64-unknown-linux-musl/garage
    path: /usr/bin/garage
    
runcmd:
  - sed -i "s|@RPC_SECRET|$(openssl rand -hex 32)|g" /etc/garage.toml
  - sed -i "s|@ADMIN_TOKEN|$(openssl rand -base64 32)|g" /etc/garage.toml
  - sed -i "s|@METRICS_TOKEN|$(openssl rand -base64 32)|g" /etc/garage.toml


