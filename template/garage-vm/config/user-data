#cloud-config

users:
  - name: root
    lock_passwd: false

    ssh_authorized_keys:
       - ssh-rsa  luke@luke-neon
ssh_pwauth: false
disable_root: false

runcmd:
  - |
    cat > /etc/garage.toml <<EOF
    metadata_dir = "/tmp/meta"
    data_dir = "/tmp/data"
    db_engine = "sqlite"

    replication_factor = 1

    rpc_bind_addr = "[::]:3901"
    rpc_public_addr = "127.0.0.1:3901"
    rpc_secret = "$(openssl rand -hex 32)"

    [s3_api]
    s3_region = "garage"
    api_bind_addr = "[::]:3900"
    root_domain = ".s3.garage.localhost"
    advertise_endpoint = "http://s3.garage.localhost:3900"

    [s3_web]
    bind_addr = "[::]:3902"
    root_domain = ".web.garage.localhost"
    index = "index.html"

    [admin]
    api_bind_addr = "[::]:3903"
    admin_token = "$(openssl rand -base64 32)"
    metrics_token = "$(openssl rand -base64 32)"
    EOF
  - wget -O /usr/bin/garage https://garagehq.deuxfleurs.fr/_releases/v2.4.1/aarch64-unknown-linux-musl/garage
  - chmod +x /usr/bin/garage

